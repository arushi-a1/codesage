# --- Core secrets ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- GitHub ---
GITHUB_TOKEN=ghp_...          # needed for private repos / higher rate limits
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Postgres ---
POSTGRES_USER=codesage
POSTGRES_PASSWORD=codesage
POSTGRES_DB=codesage
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codesage:codesage@postgres:5432/codesage

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=codesage

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
REPO_CLONE_DIR=/data/repos
MAX_FILE_SIZE_KB=800
CHUNK_MAX_TOKENS=400
